ENVIRONMENT=development
DEBUG=true

# SAFETY: defaults to true so a first run with real API keys can never
# accidentally burn through provider credits — every batch's discovery
# limit and target count are silently clamped down to 25 while this is on,
# no matter what a caller requests. Set to false once you understand your
# configured providers' real cost/yield and want to run full-sized batches.
LIVE_TEST_MODE=true

# API
CORS_ORIGINS=["http://localhost:3000"]

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql+psycopg://leads_agent:leads_agent@localhost:5432/leads_agent

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Providers
# Apollo is used ONLY for PERSON_ENRICHMENT ("Unlock Contacts", triggered
# explicitly per selected person via POST /people/{id}/enrich). Leave
# APOLLO_API_KEY unset to skip it — PERSON_ENRICHMENT requests then return an
# honest UNAVAILABLE status rather than fabricating contact data.
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# Explorium is used for COMPANY_DISCOVERY (real company search/filtering).
# Leave EXPLORIUM_API_KEY unset to run on MockCompanyDataProvider's fake
# companies instead — nothing fabricates real-looking data when this is unset.
EXPLORIUM_API_KEY=
EXPLORIUM_BASE_URL=https://api.explorium.ai/v2

# Free, no-API-key COMPANY_ENRICHMENT from SEC EDGAR (US public companies
# only) and Wikidata (companies notable enough to have a Wikidata page) —
# OFF by default since they make real network calls and have genuinely
# narrow coverage (most private SMB companies won't be found in either).
# Set to true to try them as a free, best-effort supplementary source.
ENABLE_FREE_COMPANY_ENRICHMENT_PROVIDERS=false

# Free, no-API-key COMPANY_ENRICHMENT tech-stack detection — one homepage
# fetch per company, checked against a small, curated table of unambiguous
# platform signatures (Shopify/WordPress/HubSpot/etc.). OFF by default for
# the same reason as ENABLE_FREE_COMPANY_ENRICHMENT_PROVIDERS above (a real
# network call per company, even though it costs nothing). Set to true to
# enable it.
ENABLE_TECH_STACK_DETECTOR=false

# Hermes is a SECONDARY, complementary COMPANY_DISCOVERY source — an async,
# browser-driven research agent, used only when Explorium (the primary
# source) doesn't produce enough genuinely ICP-matching companies. Leave
# HERMES_API_TOKEN unset to run Explorium-only, exactly as before this was
# added. See app/providers/hermes.py for the full API contract.
HERMES_BASE_URL=http://198.244.141.137
HERMES_API_TOKEN=

# Unipile is used for PEOPLE_DISCOVERY (real LinkedIn people search) and,
# only as a fallback when Explorium doesn't supply one, COMPANY_ENRICHMENT
# (real LinkedIn company profile lookup). All three values are required
# together — Unipile requires a pre-connected LinkedIn account, unlike
# Apollo/Explorium's simple API-key auth. Leave any of these unset to run on
# mock providers instead of a partially-configured real one.
UNIPILE_API_KEY=
# Unipile issues a dedicated subdomain (DSN) per account — not a shared
# hostname — e.g. https://api8.unipile.com:13111
UNIPILE_DSN=
# The id of the LinkedIn account connected in your Unipile dashboard that
# searches are performed from.
UNIPILE_ACCOUNT_ID=

# Abstract API's Email Validation & Verification endpoint — a second,
# independent PERSON_ENRICHMENT provider that performs a real, live SMTP/MX/
# catch-all/disposable deliverability check on an already-known email
# (never discovers one itself). Genuinely free up to 100 requests/month
# (a recurring monthly allowance, confirmed against abstractapi.com/pricing
# — not an expiring trial). Get a free key at abstractapi.com. Leave unset
# to run PERSON_ENRICHMENT on Apollo alone, exactly as before this was added.
ABSTRACT_EMAIL_API_KEY=
ABSTRACT_EMAIL_BASE_URL=https://emailvalidation.abstractapi.com/v1

# Abstract API's Phone Validation endpoint — a third, independent
# PERSON_ENRICHMENT provider that checks format validity, line type
# (mobile/landline/voip), and carrier for an already-known phone number
# (never discovers one itself — nothing in this codebase finds a phone
# number on its own; this only verifies one a human has separately
# recorded as evidence). Genuinely free up to 100 requests/month, same
# account family as ABSTRACT_EMAIL_API_KEY above. Leave unset to skip it.
ABSTRACT_PHONE_API_KEY=
ABSTRACT_PHONE_BASE_URL=https://phonevalidation.abstractapi.com/v1

# OpenAI is used for LLM qualification (PASS-gated candidates only — a
# hard-rule FAIL/HOLD never reaches it) and adversarial review. Leave
# OPENAI_API_KEY unset to run on a deterministic mock provider instead —
# nothing fabricates a real-looking qualification when this is unset, but
# every candidate that reaches this step gets an automatic GOOD_FIT rather
# than a real discriminating judgment. Set this if you want qualification
# to genuinely distinguish strong fits from weak ones.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-nano

# Tavily and Serper are web-search COMPANY_DISCOVERY sources — used in
# "safe" mode (web-search only) and "hard" mode (every configured source
# combined). They cover industries Explorium's fixed taxonomy can't
# resolve, but return free-text search results, not a structured database
# record — so hard-rule evidence for employee count/geography is rarely
# available for a Tavily/Serper-only candidate (a free-text description
# bridge partially compensates for industry/company_type; see
# docs/architecture.md). Leave either unset to keep that provider out of
# the registry entirely; neither affects "fast" mode (Explorium-only).
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Signal Check reuses TAVILY_API_KEY above (no separate credential) to run
# two extra, targeted searches per company — hiring-for-marketing and
# funding announcements — so the existing MARKETING_HIRING/FUNDING signal
# categories in app/services/commercial_signal_extractor.py have real
# evidence to detect instead of none. OFF by default: it costs two extra
# Tavily calls per company, a real cost you should opt into consciously.
# Requires TAVILY_API_KEY to be set; has no effect otherwise.
ENABLE_SIGNAL_CHECK_PROVIDER=false

SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev

# Gemini is an optional, SEPARATE provider slot used only for ICP
# discovery-strategy interpretation (term expansion before a search runs)
# or deep-mode pre-screening — never for qualification/adversarial review,
# which always use OPENAI_API_KEY above. Leave unset to keep both of
# those steps on OpenAI (or the mock, if OPENAI_API_KEY is also unset).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
# "openai" (default) | "gemini" — merely setting GEMINI_API_KEY does NOT
# switch anything on its own; this explicit selector is required too.
DISCOVERY_STRATEGY_LLM_PROVIDER=openai

# Export webhook — when a pipeline run completes, its export JSON is POSTed
# to this URL (HMAC-signed with EXPORT_WEBHOOK_SECRET so the receiver can
# verify authenticity). This is a generic bridge into Zapier/Make/n8n/your
# own server/a Slack incoming webhook — not a specific CRM integration. No
# OAuth, no third-party credential of any kind. Leave EXPORT_WEBHOOK_URL
# unset to keep every pipeline run exactly as before this was added (no
# outbound call is ever attempted).
EXPORT_WEBHOOK_URL=
# Required whenever EXPORT_WEBHOOK_URL is set — generate any random string,
# e.g. `openssl rand -hex 32`. Never sent anywhere; used only locally to
# compute the X-Lead-Agent-Signature header.
EXPORT_WEBHOOK_SECRET=
EXPORT_WEBHOOK_TIMEOUT_SECONDS=10.0
